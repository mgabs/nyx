{
    "manifest_version": 2,
    "browser_action": {
        "default_title": "Nyx",
        "default_icon": {
            "38": "icons/nyx_active_38.png",
            "19": "icons/nyx_active_19.png"
        },
        "default_popup": "ui/popup/index.html"
    },
    "applications": {
        "gecko": {
            "id": "nyx@mgabs.github.io",
            "strict_min_version": "78.0a1"
        }
    },
    "background": {
        "page": "background/index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "inject/fallback.js",
                "inject/index.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": false
        }
    ],
    "permissions": [
        "alarms",
        "storage",
        "tabs",
        "theme",
        "messagesModify",
        "<all_urls>"
    ]
}
